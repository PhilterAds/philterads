// philterads.com: static site in site/, served as Workers static assets (no Worker code).
// Deploy: CLOUDFLARE_API_TOKEN=... CLOUDFLARE_ACCOUNT_ID=... npx wrangler deploy
{
  "name": "philterads-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "philterads.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
